{
  "name": "typose",
  "productName": "Typose",
  "version": "0.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "build:hooks": "electron-vite build --mode test-hooks",
    "start": "electron-vite preview",
    "package": "install-electron && electron-builder --dir --publish never"
  },
  "dependencies": {
    "typose-node": "0.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1"
  },
  "build": {
    "appId": "dev.typose.app",
    "files": [
      "out/**",
      "!**/node_modules/typose-node/hooks{,/**}",
      {
        "from": "renderer/assets/fonts",
        "to": "third-party/fonts",
        "filter": [
          "README.md",
          "LICENSE-*.txt"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      "bin/**"
    ],
    "electronDist": "../node_modules/electron/dist",
    "npmRebuild": false,
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "mac": {
      "identity": null
    },
    "electronFuses": {
      "resetAdHocDarwinSignature": true,
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    }
  }
}
